# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yukdesain_studio?schema=public"

# Auth
AUTH_SECRET="your-secret-key-change-in-production"
SESSION_MAX_AGE=604800

# Storage (R2/S3) — Cloudflare R2 free tier: 500GB storage, 1M Class A + 10M Class B req/month
# STORAGE_BUCKET="yukdesain-assets"
# STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"  # tanpa bucket prefix
# STORAGE_ACCESS_KEY="your-access-key"
# STORAGE_SECRET_KEY="your-secret-key"
# STORAGE_PUBLIC_URL_BASE="https://pub-<hash>.r2.dev"  # dari R2 bucket Settings → Public access

# Email (Resend)
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="noreply@yukdesain.com"

# WhatsApp Cloud API (Meta) — docs/WHATSAPP_AI_CHATBOT.md §7
# WHATSAPP_ACCESS_TOKEN="EAAG..."              # System User token permanen
# WHATSAPP_PHONE_NUMBER_ID="1234567890"
# WHATSAPP_APP_SECRET="..."                    # verifikasi X-Hub-Signature-256
# WHATSAPP_VERIFY_TOKEN="random-string-panjang"
# WHATSAPP_GRAPH_VERSION="v23.0"               # cek versi terbaru di dokumentasi Meta
# WHATSAPP_TEMPLATE_LANG="id"
# WHATSAPP_GRAPH_BASE_URL="https://graph.facebook.com"  # opsional; hanya diganti untuk uji lokal dengan server tiruan

# Claude API (bot WhatsApp)
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_BASE_URL="https://api.anthropic.com"   # opsional; jangan ganti di production tanpa persetujuan (data klien lewat server ini)
# WA_AI_MODEL="claude-haiku-5-5"                  # chat & caption gambar
# WA_AI_EXTRACTION_MODEL="claude-sonnet-5-5"      # ekstraksi bukti transfer & ringkasan brief
# WA_AI_MAX_TOKENS=800

# Gateway AI pihak ketiga untuk TESTING (format Anthropic Messages API). Dipilih di Settings › WhatsApp ›
# Model AI. Semua chat klien dikirim ke gateway ini: jangan dipakai untuk klien sungguhan.
# AI_GATEWAY_API_KEY="..."
# AI_GATEWAY_BASE_URL="https://gateway.olagon.site/anthropic"
# AI_GATEWAY_LABEL="Olagon gateway"
# AI_GATEWAY_MODEL="claude-sonnet-4-6"
# AI_GATEWAY_EXTRACTION_MODEL="claude-sonnet-4-6"

# Storage privat untuk bukti transfer & media WA (tanpa akses publik)
# STORAGE_PRIVATE_BUCKET="yukdesain-private"

# URL publik portal (untuk link tracking yang dikirim bot). Opsional; default dari Origin request owner.
# APP_PUBLIC_URL="https://portal.yukdesain.com"

# Fonnte: saluran WhatsApp tidak resmi untuk TESTING (docs/WHATSAPP_CHANNEL_FONNTE.md). Dipilih di
# Settings › WhatsApp › Saluran WhatsApp; nomor dihubungkan dengan scan QR dari portal.
# FONNTE_DEVICE_TOKEN="..."                  # token device dari dashboard Fonnte
# FONNTE_WEBHOOK_SECRET="random-string-panjang" # bagian rahasia URL webhook, buat dengan: openssl rand -hex 24

# Notifikasi web push owner (docs/OWNER_NOTIFICATIONS_INBOX.md). Buat sekali dengan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@yukdesain.com"

# Kirimi (gateway scan QR, saluran ketiga; docs/WHATSAPP_CHANNEL_KIRIMI.md). Rahasia: isi di VPS saja.
KIRIMI_USER_CODE=""
KIRIMI_SECRET=""
KIRIMI_DEVICE_ID=""
KIRIMI_WEBHOOK_SECRET="" # acak, minimal 16 karakter (openssl rand -hex 24)
KIRIMI_SIGNING_SECRET="" # opsional: Signing secret dari tab Webhook perangkat di dashboard Kirimi
